# Copy to .env, fill what you have, then:  set -a; source .env; set +a
# .env is gitignored. Never commit it. Use throwaway/scoped keys.

# ransack lane (your product)
RANSACK_MCP_TOKEN=
# RANSACK_MCP_URL=https://ransack.tools

# no-search control lane + SimpleQA judge (any OpenAI-compatible endpoint)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# NOSEARCH_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o

# competitors
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
